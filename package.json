{
  "name": "my-shop-inventory-manager",
  "version": "1.0.0",
  "description": "Private Offline Desktop Inventory Management Software for Windows",
  "main": "dist-electron/main.js",
  "author": "Shop Admin",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.node.json",
    "build:electron": "tsc -p tsconfig.node.json",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.1.2",
    "clsx": "^2.1.1",
